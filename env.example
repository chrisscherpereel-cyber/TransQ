# Local development only. Streamlit Cloud uses .streamlit/secrets.toml instead.

# Required for accounts and saved keys. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#     (or, with no Python: openssl rand -base64 48)
APP_SECRET=

# Storage: leave the Dropbox lines blank to use encrypted local files.
DATA_DIR=.data
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FOLDER=/lecture-quiz-builder

# Optional fallback API keys — each user can save their own in the app instead.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
