# Copy to .streamlit/secrets.toml for local dev, or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).

# ---------------------------------------------------------------------------
# REQUIRED for accounts, saved settings, and saved API keys.
# Everything persisted is encrypted with a key derived from this value.
# Generate one — do not invent one:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#     (or, with no Python: openssl rand -base64 48)
# Changing it later makes all existing accounts unreadable.
# ---------------------------------------------------------------------------
APP_SECRET = "paste-a-long-random-string-here"

# ---------------------------------------------------------------------------
# Storage backend. With Dropbox credentials set, data goes to a Dropbox app
# folder — the only option that survives a Streamlit Cloud restart. Without
# them, encrypted local files are used (fine on a machine you control).
# See the README for how to get a refresh token.
# ---------------------------------------------------------------------------
# DROPBOX_APP_KEY = "..."
# DROPBOX_APP_SECRET = "..."
# DROPBOX_REFRESH_TOKEN = "..."
# DROPBOX_FOLDER = "/lecture-quiz-builder"
# DATA_DIR = ".data"                      # local backend only

# ---------------------------------------------------------------------------
# API keys. Each user can save their own in the app instead — anything set here
# is a fallback available to everyone who signs in.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY = "sk-or-v1-..."     # default provider
# GEMINI_API_KEY = "AIza..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
# XAI_API_KEY = "xai-..."
